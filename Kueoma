

<!DOCTYPE html>

<html>

<head>

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>MADE MY 4KUROMI</title>

<style>

body {

  background: #10091c;

  color: white;

  font-family: Arial;

  text-align: center;

}

.menu {

  background: #241333;

  border: 2px solid #bd75ff;

  border-radius: 20px;

  padding: 20px;

  margin: 30px auto;

  max-width: 340px;

}

h1 {

  color: #e0aaff;

  font-size: 25px;

}

button {

  display: block;

  width: 100%;

  margin: 12px 0;

  padding: 15px;

  border: none;

  border-radius: 12px;

  background: #a855f7;

  color: white;

  font-size: 16px;

  font-weight: bold;

}

button:active {

  background: #7135ad;

}

#status {

  color: #e0aaff;

}

</style>

</head>

<body>

<div class="menu">

<h1>💜 MADE MY 4KUROMI 💜</h1>

<p>My Personal Script Hub</p>

<button onclick="selectTool('Flying Carpet')">

🪄 Flying Carpet

</button>

<button onclick="selectTool('Hair Dryer')">

💨 Hair Dryer

</button>

<button onclick="selectTool('Water Ball')">

💧 Water Ball

</button>

<p id="status">Choose your tool!</p>

</div>

<script>

function selectTool(name) {

 document.getElementById("status").innerText =

 name + " selected! 💜";

}

</script>

</body>

</html>
