--[[
KOMPLETTES MENÜ SKRIPT (EIN SKRIPT)
✅ Ziehbares Menü
✅ X‑Schließen Button
✅ 💧 Water Bow
✅ 🔥 Dryer
✅ 🪞 Flying Carpet
✅ 🌈 Rainbow Sit
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer
local PlayerGui = Player.PlayerGui

-- Variablen
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local dragging = false
local dragStart = Vector2.new()
local startPos = UDim2.new()
local menuVisible = true
local carpetActive = false
local carpet
local rainbowSitActive = false

-- GUI ERSTELLEN
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "KomplettesItemMenu"
ScreenGui.Parent = PlayerGui

local MainFrame = Instance.new("Frame")
MainFrame.Name = "HauptMenue"
MainFrame.Size = UDim2.new(0,240,0,300)
MainFrame.Position = UDim2.new(0.02,0,0.02,0)
MainFrame.BackgroundColor3 = Color3.new(0.12,0.12,0.15)
MainFrame.BorderSizePixel = 2
MainFrame.Parent = ScreenGui

-- Zieh‑Titelleiste
local TitleBar = Instance.new("TextLabel")
TitleBar.Name = "ZiehLeiste"
TitleBar.Size = UDim2.new(1,-30,0,32)
TitleBar.Position = UDim2.new(0,0,0,0)
TitleBar.BackgroundColor3 = Color3.new(0.25,0.25,0.45)
TitleBar.Text = "✨ Item Menü"
TitleBar.TextColor3 = Color3.new(1,1,1)
TitleBar.TextSize = 14
TitleBar.Parent = MainFrame

-- X Schließen Button
local CloseBtn = Instance.new("TextButton")
CloseBtn.Name = "SchliessenBtn"
CloseBtn.Size = UDim2.new(0,30,0,32)
CloseBtn.Position = UDim2.new(1,-30,0,0)
CloseBtn.BackgroundColor3 = Color3.new(0.6,0.1,0.1)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.new(1,1,1)
CloseBtn.Parent = MainFrame

-- Funktions‑Buttons
local btnWaterBow = Instance.new("TextButton")
local btnDryer = Instance.new("TextButton")
local btnFlyingCarpet = Instance.new("TextButton")
local btnRainbowSit = Instance.new("TextButton")

local buttons = {btnWaterBow, btnDryer, btnFlyingCarpet, btnRainbowSit}
local btnNamen = {"💧 Water Bow","🔥 Dryer","🪞 Flying Carpet","🌈 Rainbow Sit"}

for i,btn in ipairs(buttons) do
	btn.Size = UDim2.new(0.9,0,0,42)
	btn.Position = UDim2.new(0.05,0,0.14 + ((i‑1)*0.17),0)
	btn.BackgroundColor3 = Color3.new(0.3,0.3,0.5)
	btn.TextColor3 = Color3.new(1,1,1)
	btn.Text = btnNamen[i]
	btn.Parent = MainFrame
end

-- === MENÜ ZIEHEN / VERSCHIEBEN ===
TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

-- === X Schalter (Menü an/aus) ===
CloseBtn.MouseButton1Click:Connect(function()
	menuVisible = not menuVisible
	MainFrame.Visible = menuVisible
end)

-- === 1. WATER BOW ===
btnWaterBow.MouseButton1Click:Connect(function()
	local bow = game.ReplicatedStorage:FindFirstChild("WaterBow")
	if bow then
		local clone = bow:Clone()
		clone.Parent = Character
		print("✅ Water Bow aktiviert")
	else
		warn("❌ WaterBow fehlt in ReplicatedStorage")
	end
end)

-- === 2. DRYER ===
btnDryer.MouseButton1Click:Connect(function()
	local dryer = game.ReplicatedStorage:FindFirstChild("Dryer")
	if dryer then
		local clone = dryer:Clone()
		clone.Parent = Character
		print("✅ Dryer aktiviert")
	else
		warn("❌ Dryer fehlt in ReplicatedStorage")
	end
end)

-- === 3. FLYING CARPET ===
btnFlyingCarpet.MouseButton1Click:Connect(function()
	if not carpetActive then
		carpetActive = true
		carpet = Instance.new("Part")
		carpet.Name = "FlyingCarpet"
		carpet.Size = Vector3.new(3,0.2,2)
		carpet.Position = Character.HumanoidRootPart.Position + Vector3.new(0,2,0)
		carpet.Parent = workspace
		carpet.Anchored = false
		carpet.CanCollide = false

		local weld = Instance.new("WeldConstraint")
		weld.Part0 = carpet
		weld.Part1 = Character.HumanoidRootPart
		weld.Parent = carpet

		RunService.RenderStepped:Connect(function()
			if carpetActive and carpet and Character:FindFirstChild("HumanoidRootPart") then
				local speed = 0.6
				carpet.Velocity = Vector3.new(0,1,0) + Player:GetMouse().Hit.LookVector * speed
			end
		end)
		print("✅ Flying Carpet AN")
	else
		carpetActive = false
		if carpet then carpet:Destroy() end
		print("✅ Flying Carpet AUS")
	end
end)

-- === 4. RAINBOW SIT ===
btnRainbowSit.MouseButton1Click:Connect(function()
	rainbowSitActive = not rainbowSitActive
	if rainbowSitActive then
		Humanoid.Sit = true
		task.spawn(function()
			while rainbowSitActive do
				for hue=0,1,0.05 do
					if not rainbowSitActive then break end
					for _,limb in ipairs(Character:GetChildren()) do
						if limb:IsA("BasePart") then
							limb.Color = Color3.fromHSV(hue,0.7,1)
						end
					end
					task.wait(0.05)
				end
			end
		end)
		print("✅ Rainbow Sit AN")
	else
		rainbowSitActive = false
		Humanoid.Sit = false
		print("✅ Rainbow Sit AUS")
	end
end)

-- === CHARAKTER RESPAWN ===
Player.CharacterAdded:Connect(function(neuerChar)
	Character = neuerChar
	Humanoid = Character:WaitForChild("Humanoid")
end)
