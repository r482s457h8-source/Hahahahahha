
-- MY SCRIPT | Roblox Studio
-- LocalScript in StarterPlayerScripts

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remote = RS:WaitForChild("GearRemote")

local gui = Instance.new("ScreenGui")
gui.Name = "MyScript"
gui.ResetOnSpawn = false
gui.Parent = player.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(260, 230)
frame.Position = UDim2.new(0.5,-130,0.5,-115)
frame.BackgroundColor3 = Color3.fromRGB(20,20,24)
frame.Parent = gui

Instance.new("UICorner",frame).CornerRadius =
    UDim.new(0,10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,45)
title.BackgroundTransparency = 1
title.Text = "MY SCRIPT"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.GothamBold
title.TextSize = 22
title.Parent = frame

local function button(name,y,callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-20,0,42)
    b.Position = UDim2.new(0,10,0,y)
    b.BackgroundColor3 = Color3.fromRGB(45,45,52)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = name
    b.Font = Enum.Font.Gotham
    b.TextSize = 14
    b.Parent = frame
    Instance.new("UICorner",b).CornerRadius =
        UDim.new(0,6)
    b.Activated:Connect(callback)
end

button("Rainbow Carpet",55,function()
    remote:FireServer("Give","Rainbow Carpet")
end)

button("Hair Dryer",105,function()
    remote:FireServer("Give","Hair Dryer")
end)

button("Close",155,function()
    frame.Visible = false
end)

local open = Instance.new("TextButton")
open.Size = UDim2.fromOffset(70,35)
open.Position = UDim2.new(0,10,0.5,0)
open.Text = "OPEN"
open.Parent = gui

open.Activated:Connect(function()
    frame.Visible = not frame.Visible
end)

print("MY SCRIPT loaded!")
