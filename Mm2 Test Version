-- Echter Roblox Fliegender Teppich (ID: 225921000)
local function giveRobloxCarpet()
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://225921000")
    end)

    local tool
    if success and objects and objects[1] then
        tool = objects[1]
        -- Alte blockierte Server-Skripte im Gear entfernen
        for _, child in ipairs(tool:GetDescendants()) do
            if child:IsA("Script") or child:IsA("LocalScript") then
                child:Destroy()
            end
        end
    else
        -- Fallback falls das Spiel externe Assets blockiert
        tool = Instance.new("Tool")
        tool.Name = "Rainbow Magic Carpet"
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(4, 0.2, 6)
        handle.Color = Color3.fromRGB(255, 105, 180)
        handle.Parent = tool
    end

    -- Regenbogen-Schweif hinzufügen
    local handle = tool:FindFirstChild("Handle")
    if handle then
        handle.CanCollide = false
        local att0 = Instance.new("Attachment", handle)
        att0.Position = Vector3.new(-1.5, 0, 2)
        local att1 = Instance.new("Attachment", handle)
        att1.Position = Vector3.new(1.5, 0, 2)

        local trail = Instance.new("Trail")
        trail.Attachment0 = att0
        trail.Attachment1 = att1
        trail.Lifetime = 1.2
        trail.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 255, 127)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(138, 43, 226))
        })
        trail.Parent = handle
    end

    -- Funktionierende Flugsteuerung
    local flying = false
    local bodyVel, bodyGyro, connection

    tool.Equipped:Connect(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        flying = true
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVel.Parent = root

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bodyGyro.P = 1e4
        bodyGyro.Parent = root

        connection = RunService.RenderStepped:Connect(function()
            if not flying or not root then return end
            local cam = workspace.CurrentCamera
            bodyGyro.CFrame = cam.CFrame
            bodyVel.Velocity = cam.CFrame.LookVector * 60
        end)
    end)

    tool.Unequipped:Connect(function()
        flying = false
        if connection then connection:Disconnect() end
        if bodyVel then bodyVel:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end)

    tool.Parent = player.Backpack
end

-- Echter Roblox Föhn / Blow Dryer (ID: 11719016)
local function giveRobloxHairdryer()
    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://11719016")
    end)

    local tool
    if success and objects and objects[1] then
        tool = objects[1]
        for _, child in ipairs(tool:GetDescendants()) do
            if child:IsA("Script") or child:IsA("LocalScript") then
                child:Destroy()
            end
        end
    else
        tool = Instance.new("Tool")
        tool.Name = "Blow Dryer"
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(0.6, 0.8, 1.5)
        handle.Parent = tool
    end

    local handle = tool:FindFirstChild("Handle")
    local blowing = false
    local blowConnection

    if handle then
        handle.CanCollide = false
        -- Originaler Roblox Föhn-Sound (ID: 11717967)
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://11717967"
        sound.Looped = true
        sound.Volume = 1
        sound.Parent = handle

        -- Luft-Effekt
        local wind = Instance.new("ParticleEmitter")
        wind.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
        wind.Size = NumberSequence.new(0.4, 1.8)
        wind.Lifetime = NumberRange.new(0.3, 0.5)
        wind.Rate = 60
        wind.Speed = NumberRange.new(20, 30)
        wind.Enabled = false
        wind.Parent = handle

        tool.Activated:Connect(function()
            blowing = true
            wind.Enabled = true
            sound:Play()

            blowConnection = RunService.RenderStepped:Connect(function()
                if not blowing then return end
                local char = player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    -- Kontinuierlicher Rückstoß beim Gedrückthalten
                    root.Velocity = root.CFrame.LookVector * -25 + Vector3.new(0, 8, 0)
                end
            end)
        end)

        tool.Deactivated:Connect(function()
            blowing = false
            wind.Enabled = false
            sound:Stop()
            if blowConnection then blowConnection:Disconnect() end
        end)

        tool.Unequipped:Connect(function()
            blowing = false
            wind.Enabled = false
            sound:Stop()
            if blowConnection then blowConnection:Disconnect() end
        end)
    end

    tool.Parent = player.Backpack
end

