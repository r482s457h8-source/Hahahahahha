local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "PinkMM2Menu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.new(0, 260, 0, 220)
main.Position = UDim2.new(0.5, -130, 0.5, -110)
main.BackgroundColor3 = Color3.fromRGB(255, 130, 200)
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 18)
corner.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -45, 0, 45)
title.BackgroundTransparency = 1
title.Text = "💗 PINK MM2 💗"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 23
title.Parent = main

local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 35, 0, 35)
close.Position = UDim2.new(1, -40, 0, 5)
close.Text = "X"
close.TextSize = 22
close.TextColor3 = Color3.new(1, 1, 1)
close.BackgroundColor3 = Color3.fromRGB(220, 50, 130)
close.Parent = main

local reopen = Instance.new("TextButton")
reopen.Size = UDim2.new(0, 55, 0, 55)
reopen.Position = UDim2.new(0, 15, 0.5, -27)
reopen.Text = "💗"
reopen.TextSize = 28
reopen.BackgroundColor3 = Color3.fromRGB(255, 130, 200)
reopen.Visible = false
reopen.Parent = gui

close.MouseButton1Click:Connect(function()
    main.Visible = false
    reopen.Visible = true
end)

reopen.MouseButton1Click:Connect(function()
    main.Visible = true
    reopen.Visible = false
end)

local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, -20, 0, 100)
info.Position = UDim2.new(0, 10, 0, 75)
info.BackgroundTransparency = 1
info.Text = "🪄 Flying Carpet\n💨 Hair Dryer\n✨ Pink Style"
