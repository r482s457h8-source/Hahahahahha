
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local event = Instance.new("RemoteEvent")
event.Name = "ItemHubEvent"
event.Parent = ReplicatedStorage

local cooldown = {}

event.OnServerEvent:Connect(function(player, action)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if action == "Water" then
        local pos = root.Position + root.CFrame.LookVector * 30

        workspace.Terrain:FillBall(
            pos, 18, Enum.Material.Water
        )

        task.delay(30, function()
            workspace.Terrain:FillBall(
                pos, 18, Enum.Material.Air
            )
        end)

    elseif action == "Dryer" then
        if cooldown[player] then return end
        cooldown[player] = true

        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player and other.Character then
                local target = other.Character:FindFirstChild("HumanoidRootPart")

                if target then
                    local offset = target.Position - root.Position
                    local distance = offset.Magnitude

                    if distance < 35 and distance > 0 then
                        local direction = offset.Unit
                        if root.CFrame.LookVector:Dot(direction) > 0.5 then
                            target:ApplyImpulse(
                                (direction * 100 + Vector3.new(0,45,0))
                                * target.AssemblyMass
                            )
                        end
                    end
                end
            end
        end

        task.delay(2, function()
            cooldown[player] = nil
        end)
    end
end)

