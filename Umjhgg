-- RAINBOW FLYING CARPET

local flying = false
local flightConnection
local velocity
local gyro
local rug

local colors = {
    Color3.fromRGB(255,0,0),
    Color3.fromRGB(255,130,0),
    Color3.fromRGB(255,230,0),
    Color3.fromRGB(0,220,0),
    Color3.fromRGB(0,130,255),
    Color3.fromRGB(100,0,255),
    Color3.fromRGB(220,0,220)
}

local function stopFlying()
    flying = false

    if flightConnection then
        flightConnection:Disconnect()
        flightConnection = nil
    end

    if velocity then velocity:Destroy() end
    if gyro then gyro:Destroy() end
    if rug then rug:Destroy() end

    carpet.Text = "🌈 Flying Carpet"
end

carpet.MouseButton1Click:Connect(function()
    if flying then
        stopFlying()
        return
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    flying = true

    rug = Instance.new("Model")
    rug.Name = "RainbowFlyingCarpet"
    rug.Parent = char

    local base = Instance.new("Part")
    base.Size = Vector3.new(7,0.25,4)
    base.Position = root.Position - Vector3.new(0,3,0)
    base.Color = Color3.fromRGB(120,50,200)
    base.Anchored = false
    base.CanCollide = false
    base.Parent = rug

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = base
    weld.Parent = base

    for i,color in ipairs(colors) do
        local stripe = Instance.new("Part")
        stripe.Size = Vector3.new(7,0.28,4/7)
        stripe.Color = color
        stripe.Material = Enum.Material.SmoothPlastic
        stripe.CanCollide = false
        stripe.Anchored = false
        stripe.Position = base.Position +
            Vector3.new(0,0,(i-4)*0.57)
        stripe.Parent = rug

        local w = Instance.new("WeldConstraint")
        w.Part0 = base
        w.Part1 = stripe
        w.Parent = stripe
    end

    velocity = Instance.new("BodyVelocity")
    velocity.MaxForce = Vector3.new(1e6,1e6,1e6)
    velocity.Parent = root

    gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(1e6,1e6,1e6)
    gyro.Parent = root

    flightConnection = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        local move = camera.CFrame.LookVector * 45

        velocity.Velocity = move
        gyro.CFrame = camera.CFrame
    end)

    carpet.Text = "🛑 STOP FLYING"
end)

player.CharacterAdded:Connect(function()
    stopFlying()
end)
