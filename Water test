	btn.Parent = buttonContainer

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn

	btn.MouseButton1Click:Connect(callback)
end

-- 2. TOOL-FUNKTIONEN

local function giveWaterBow()
	local backpack = player:FindFirstChild("Backpack")
	if not backpack or backpack:FindFirstChild("Water Bow") then return end

	local tool = Instance.new("Tool")
	tool.Name = "Water Bow"
	tool.RequiresHandle = false

	tool.Activated:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local waterBall = Instance.new("Part")
		waterBall.Size = Vector3.new(2, 2, 2)
		waterBall.Shape = Enum.PartType.Ball
		waterBall.BrickColor = BrickColor.new("Bright blue")
		waterBall.Material = Enum.Material.Glass
		waterBall.Transparency = 0.3
		waterBall.CanCollide = false
		waterBall.CFrame = root.CFrame * CFrame.new(0, 1, -4)
		waterBall.Parent = workspace

		local bv = Instance.new("BodyVelocity")
		bv.Velocity = root.CFrame.LookVector * 80
		bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bv.Parent = waterBall

		Debris:AddItem(waterBall, 3)
	end)

	tool.Parent = backpack
end

local function giveRainbowCarpet()
	local backpack = player:FindFirstChild("Backpack")
	if not backpack or backpack:FindFirstChild("Rainbow Carpet") then return end

	local tool = Instance.new("Tool")
	tool.Name = "Rainbow Carpet"
	tool.RequiresHandle = false

	local flying = false
	local carpet, bv, conn

	tool.Equipped:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		flying = true
		carpet = Instance.new("Part")
		carpet.Size = Vector3.new(6, 0.4, 8)
		carpet.Anchored = false
		carpet.CanCollide = false
		carpet.Material = Enum.Material.Neon
		carpet.Parent = workspace

		local weld = Instance.new("WeldConstraint")
		carpet.CFrame = root.CFrame * CFrame.new(0, -3.2, 0)
		weld.Part0 = root
		weld.Part1 = carpet
		weld.Parent = carpet

		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bv.Parent = root

		local hue = 0
		conn = RunService.RenderStepped:Connect(function(dt)
			if not flying then return end
			hue = (hue + dt * 0.5) % 1
			carpet.Color = Color3.fromHSV(hue, 1, 1)
			bv.Velocity = workspace.CurrentCamera.CFrame.LookVector * 50
		end)
	end)

	tool.Unequipped:Connect(function()
		flying = false
		if conn then conn:Disconnect() end
		if bv then bv:Destroy() end
		if carpet then carpet:Destroy() end
	end)

	tool.Parent = backpack
end

local function giveHairDryer()
	local backpack = player:FindFirstChild("Backpack")
	if not backpack or backpack:FindFirstChild("Hair Dryer") then return end

	local tool = Instance.new("Tool")
	tool.Name = "Hair Dryer"
	tool.RequiresHandle = false

	tool.Activated:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj.Anchored and not obj:IsDescendantOf(character) then
				local distance = (obj.Position - root.Position).Magnitude
				if distance < 25 then
					local direction = (obj.Position - root.Position).Unit
					obj.AssemblyLinearVelocity = (direction + Vector3.new(0, 0.5, 0)) * 90
				end
			end
		end
	end)

	tool.Parent = backpack
end

local function giveGoldBomb()
	local backpack = player:FindFirstChild("Backpack")
	if not backpack or backpack:FindFirstChild("Gold Bomb") then return end

	local tool = Instance.new("Tool")
	tool.Name = "Gold Bomb"
	tool.RequiresHandle = false

	tool.Activated:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local bomb = Instance.new("Part")
		bomb.Size = Vector3.new(2.5, 2.5, 2.5)
		bomb.Shape = Enum.PartType.Ball
		bomb.BrickColor = BrickColor.new("Gold")
		bomb.Material = Enum.Material.Metal
		bomb.CFrame = root.CFrame * CFrame.new(0, 1, -3)
		bomb.AssemblyLinearVelocity = root.CFrame.LookVector * 45 + Vector3.new(0, 20, 0)
		bomb.Parent = workspace

		task.delay(2.5, function()
			if bomb and bomb.Parent then
				local explosion = Instance.new("Explosion")
				explosion.Position = bomb.Position
				explosion.BlastRadius = 15
				explosion.Parent = workspace
				bomb:Destroy()
			end
		end)
	end)

	tool.Parent = backpack
end

