local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "SuperPowersMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Hauptmenü
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 330)
frame.Position = UDim2.new(0.5, -130, 0.5, -165)
frame.BackgroundColor3 = Color3.fromRGB(35, 20, 65)
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius =
    UDim.new(0, 15)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundTransparency = 1
title.Text = "🌈 SUPER POWERS"
title.TextColor3 = Color3.fromRGB(255,255,255)
title.TextScaled = true
title.Parent = frame

-- Buttons
local function createButton(name, position, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 220, 0, 48)
    button.Position = UDim2.new(0, 20, 0, position)
    button.BackgroundColor3 = Color3.fromRGB(130, 65, 220)
    button.TextColor3 = Color3.new(1,1,1)
    button.TextScaled = true
    button.Text = name
    button.Parent = frame

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 10)

    button.MouseButton1Click:Connect(callback)
end

-- Wasserbogen
createButton("🌊 Water Bow", 65, function()
    print("Water Bow ausgewählt!")
end)

