-- Regenbogen-Fliegender Teppich
createButton("🌈 Flying Carpet", 175, function()
    local carpet = Instance.new("Part")
    carpet.Size = Vector3.new(10,0.5,6)
    carpet.Position = player.Character.HumanoidRootPart.Position
        - Vector3.new(0,3,0)
    carpet.Anchored = false
    carpet.CanCollide = true
    carpet.Material = Enum.Material.Neon
    carpet.Color = Color3.fromRGB(255,0,255)
    carpet.Name = "RainbowCarpet"
    carpet.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = carpet
    weld.Part1 = player.Character.HumanoidRootPart
    weld.Parent = carpet
end)

-- Dryer
createButton("💨 Dryer", 230, function()
    local root = player.Character
        and player.Character:FindFirstChild("HumanoidRootPart")

    if root then
        local wind = Instance.new("Part")
        wind.Shape = Enum.PartType.Ball
        wind.Size = Vector3.new(5,5,5)
        wind.Transparency = 0.5
        wind.Color = Color3.fromRGB(200,255,255)
        wind.Anchored = true
        wind.CanCollide = false
        wind.Position = root.Position + root.CFrame.LookVector * 8
        wind.Parent = workspace

        game:GetService("Debris"):AddItem(wind, 2)
    end
end)

