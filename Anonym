-- Delta Executor Universal Magic Carpet & Spawner Script
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Flying Carpet (Fliegender Teppich Ersteller)
local carpet = Instance.new("Part")
carpet.Name = "DeltaMagicCarpet"
carpet.Size = Vector3.new(6, 0.4, 6)
carpet.Position = LocalPlayer.Character.HumanoidRootPart.Position - Vector3.new(0, 3, 0)
carpet.Anchored = true
carpet.CanCollide = true
carpet.Material = Enum.Material.ForceField
carpet.BrickColor = BrickColor.new("Bright blue")
carpet.Parent = workspace

LocalPlayer.Character.HumanoidRootPart.CFrame = carpet.CFrame + Vector3.new(0, 3, 0)

-- Steuerungslogik für den fliegenden Teppich
local speed = 50
local active = true

task.spawn(function()
    while active and carpet.Parent do
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDir = moveDir + cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDir = moveDir - cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDir = moveDir - cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDir = moveDir + cam.CFrame.RightVector
        end
        
        moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
        end
        
        carpet.Position = carpet.Position + (moveDir * speed * task.wait())
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = carpet.CFrame + Vector3.new(0, 3, 0)
        end
    end
end)

-- Water Spawner (Einfacher Wasserteil / Spawner-Funktion)
local function spawnWater(position)
    local waterPart = Instance.new("Part")
    waterPart.Name = "DeltaWaterSpawner"
    waterPart.Size = Vector3.new(10, 1, 10)
    waterPart.Position = position
    waterPart.Anchored = false
    waterPart.CanCollide = true
    waterPart.Material = Enum.Material.SmoothPlastic
    waterPart.Transparency = 0.4
    waterPart.BrickColor = BrickColor.new("Cyan")
    waterPart.Parent = workspace
end

-- Erzeugt eine Wasserfläche direkt vor dir
spawnWater(LocalPlayer.Character.HumanoidRootPart.Position + (LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * 5) - Vector3.new(0, 2, 0))
