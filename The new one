-- Hilfsfunktion für Rosa Buttons
local function createPinkButton(text, posY)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.85, 0, 0, 45)
    btn.Position = UDim2.new(0.075, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(255, 182, 193) -- Helles Rosa
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(139, 0, 69) -- Dunkles Pink für gute Lesbarkeit
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = MainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = btn

    return btn
end

